class Solution {
    public int kthSmallest(int[][] matrix, int k) {
        PriorityQueue<Integer> pq=new PriorityQueue<>();        
        for(int i=0;i<matrix.length;i++)
        {
            int n=matrix[0].length;
            for(int j=0;j<n;j++)
            {
                pq.offer(matrix[i][j]);
            }
        }
        while(k-->1)
        {
            pq.poll();
        }
        return pq.poll();
    }
}
