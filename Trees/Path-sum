class Solution {
    public boolean hasPathSum(TreeNode root, int targetSum) {
        
        if(root == null)
        {
            return false;
        }
        int res=targetSum-root.val;
        if(res==0)
        {
            if(root.left==null && root.right==null){
                return true;
            }
        }
        return hasPathSum(root.left,res) ||  hasPathSum(root.right,res);


    }
}
